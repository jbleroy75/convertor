# Domaine public (le DNS doit pointer vers le serveur).
DOMAIN=convertor.jbleroy.fr
# E-mail pour Let's Encrypt (facultatif mais recommandé).
ACME_EMAIL=
# Taille max d'un transfert et quota disque total des transferts (Go).
TRANSFER_MAX_GB=50
TRANSFER_STORAGE_GB=200
# Taille max d'un fichier à convertir (Mo).
CONVERT_MAX_FILE_MB=1024
APP_MEM_LIMIT=4g
